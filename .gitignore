__pycache__/
*.py[cod]
.venv/
dist/
build/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets — API keys live in the environment, never in the repo.
.env
.env.*

# Downloaded datasets and raw API responses (regenerable, can be large).
data/raw/
data/cache/

# Decision cache and run outputs (local; study runs get committed deliberately later).
.cache/
runs/

# HTML reports (ask-or-act report); regenerable from runs.
reports/

.DS_Store

# Daily study logs (scripts/daily.sh); may name ids and errors, never input text.
logs/

# The study worktree (scripts/study-job.sh setup) links these to the main folder's.
# Patterns without a trailing slash, so the symlinks are ignored too.
/runs
/logs
/.cache
/data/raw

# `ask-or-act demo` output when run from the repo root
ask-or-act-demo*/
